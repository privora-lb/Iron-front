root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[src/game/engine.js]
# The engine is dense by design and predates the style rules below.
# Leave its formatting alone until it has been split up.
indent_size = unset
